@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--bg:#07090d;--panel:#11151d;--text:#f5f7fa;--muted:#929baa;--gold:#d6b46a;--green:#20c997;--border:#242b36}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,Arial,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}
.nav{display:flex;justify-content:space-between;align-items:center;padding:24px 0;gap:20px}.brand{font-size:22px;font-weight:800;letter-spacing:.5px;display:flex;align-items:center;gap:9px}.brand b{color:var(--gold)}.mark{display:inline-grid;place-items:center;width:32px;height:32px;border:1px solid var(--gold);color:var(--gold);border-radius:9px}
.navlinks{display:flex;align-items:center;gap:26px;color:var(--muted);font-size:14px}.navlinks a:hover{color:var(--text)}
.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 18px;border-radius:10px;font-weight:700;background:var(--gold);color:#090b10;border:1px solid var(--gold);transition:.2s}.button:hover{filter:brightness(1.08);transform:translateY(-1px)}.button.small{padding:10px 14px;font-size:13px}.button.ghost{background:transparent;color:var(--text);border-color:var(--border)}.button.full{width:100%;margin-top:16px}
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:52px;align-items:center;padding:76px 0 85px}.eyebrow{color:var(--green);font-weight:700;letter-spacing:2px;font-size:11px;display:flex;align-items:center;gap:9px}.pulse{height:7px;width:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px #20c99780}
h1{font-size:clamp(42px,5.8vw,72px);line-height:1.04;letter-spacing:-3px;margin:20px 0}h1 span{color:var(--gold)}.lead{color:var(--muted);line-height:1.8;font-size:16px;max-width:520px}.actions{display:flex;gap:12px;margin-top:27px;flex-wrap:wrap}
.hero-card{background:linear-gradient(145deg,#141923,#0d1118);border:1px solid var(--border);border-radius:18px;padding:23px;box-shadow:0 25px 80px #0005}.cardtop{display:flex;justify-content:space-between;gap:10px;font-size:10px;letter-spacing:1.4px;color:var(--muted);font-weight:700}.live{color:var(--green)}.live i{display:inline-block;width:6px;height:6px;background:var(--green);border-radius:50%;margin-right:5px}.balance-label{color:var(--muted);font-size:12px;margin-top:27px}.balance{font-size:30px;font-weight:800;margin:9px 0 5px}.balance span{font-size:13px;color:var(--green);margin-left:7px}.chart{height:150px;margin:12px 0 18px}.chart svg{width:100%;height:100%}.stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border);padding-top:18px;gap:8px}.stats div{display:flex;flex-direction:column;gap:7px}.stats small{color:var(--muted);font-size:10px}.stats b{font-size:15px}
.trust{border-block:1px solid var(--border);background:#0b0e14}.trustrow{display:flex;justify-content:space-around;gap:20px;padding:19px 0;flex-wrap:wrap}.trustrow span{display:flex;align-items:center;gap:9px;color:#b7c0cb;font-size:13px}.trustrow svg{width:17px;color:var(--gold)}
.section{padding:78px 0}.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:30px}.sectionhead h2,.darksection h2{font-size:clamp(30px,4vw,44px);letter-spacing:-1.5px;margin:10px 0 0}.sectionhead p{color:var(--muted);max-width:370px;line-height:1.6;font-size:14px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.plan{position:relative;background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:25px;overflow:hidden}.plan.popular{border-color:#b99a54;box-shadow:0 0 0 1px #b99a5420}.ribbon{position:absolute;right:0;top:0;background:var(--gold);color:#090b10;padding:7px 12px;font-size:9px;font-weight:800;letter-spacing:1px;border-radius:0 0 0 10px}.plan h3{font-size:18px;margin:0 0 20px}.amount{font-size:30px;font-weight:800}.amount small,.fee small{font-size:11px;color:var(--muted);font-weight:500;display:block;margin-top:5px}.fee{font-size:24px;color:var(--gold);font-weight:800;margin:20px 0}.plan ul{list-style:none;padding:0;margin:20px 0;color:var(--muted);font-size:13px}.plan li{display:flex;align-items:center;gap:8px;margin:13px 0}.plan li svg{width:15px;height:15px;color:var(--green)}.plan li b{margin-left:auto;color:var(--text)}.disclaimer{color:#697382;font-size:11px;margin-top:18px}
.darksection{background:#0c1017;border-block:1px solid var(--border)}.darksection h2 span{color:var(--gold)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:45px}.steps>div{border-top:1px solid var(--border);padding-top:20px}.steps em{font-style:normal;color:var(--gold);font-weight:800;font-size:12px}.steps h3{font-size:17px;margin:13px 0}.steps p{color:var(--muted);line-height:1.7;font-size:13px}
.rules{border:1px solid var(--border);background:var(--panel);border-radius:14px;padding:24px}.rules p{display:flex;align-items:flex-start;gap:12px;color:#b6bfca;line-height:1.6;font-size:14px}.rules svg{color:var(--green);min-width:17px;margin-top:2px}
.footer{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:30px 0;border-top:1px solid var(--border);color:var(--muted);font-size:12px;flex-wrap:wrap}.footer p{margin:0}.footer small{color:#697382}
@media(max-width:800px){.navlinks{display:none}.hero{grid-template-columns:1fr;gap:35px;padding:48px 0 60px}.hero-card{max-width:620px}.section{padding:55px 0}.sectionhead{align-items:start;flex-direction:column;gap:8px}.plans{grid-template-columns:1fr}.plan{max-width:none}.steps{grid-template-columns:1fr;gap:20px}.trustrow{justify-content:flex-start}.footer{flex-direction:column;align-items:flex-start}h1{letter-spacing:-2px}}
